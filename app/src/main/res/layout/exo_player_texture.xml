<?xml version="1.0" encoding="utf-8"?>
<!--
    PlayerView inflated with surface_type="texture_view" so it renders
    inside the normal View hierarchy instead of at the window level.

    SurfaceView (the default) punches through Compose's ModalBottomSheet
    causing a black screen. TextureView avoids that z-ordering issue.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    app:surface_type="texture_view"
    app:use_controller="true"
    app:resize_mode="fit"
    tools:ignore="MissingClass" />
